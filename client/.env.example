# Client environment variables for Vite
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Admin access control for the frontend (comma separated Clerk emails)
VITE_ADMIN_EMAILS=admin@example.com,your.email@example.com

# Stripe Payments
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
# Optional: local API base URL if your app uses it
# VITE_API_URL=http://localhost:3000
