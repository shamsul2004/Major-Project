# MongoDB Configuration
# Use a valid database name without dots
MONGODB_URI=mongodb://localhost:27017/edmey_learnify

# Clerk Authentication
CLERK_SECRET_KEY=your_clerk_secret_key_here

# Stripe Payments (Optional)
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# Cloudinary Configuration
CLOUDINARY_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_SECRET_KEY=your_cloudinary_secret_key

# Admin access control (comma separated Clerk emails or IDs)
ADMIN_EMAILS=admin@example.com,your.email@example.com
ADMIN_IDS=clerk_user_id_1,clerk_user_id_2

# Server Port
PORT=3000
